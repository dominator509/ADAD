#!/bin/sh
set -eu

mkdir -p /etc/nftables.d /etc/sysctl.d /etc/tor/torrc.d /usr/local/sbin \
  /etc/systemd/system /etc/wireguard /usr/local/lib/adad/llama /var/lib/adad/models

cat > /etc/sysctl.d/10-adad-disable-ipv6.conf <<'EOF'
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
net.ipv6.conf.lo.disable_ipv6 = 1
EOF

cat > /etc/nftables.d/adad-killswitch.nft <<'EOF'
flush ruleset

table inet adad_killswitch {
  chain input {
    type filter hook input priority 0; policy drop;
    iifname "lo" accept
    ct state established,related accept
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
  }

  chain output {
    type filter hook output priority 0; policy drop;
    oifname "lo" accept
    oifname "wg0" accept
    udp sport 68 udp dport 67 accept
    meta skuid "debian-tor" accept
    udp dport { 53, 5353, 1900, 137, 138 } drop
    tcp dport { 139, 445 } drop
  }
}
EOF

# This is deliberately a separate, stricter ruleset. The link monitor loads it
# after a down/deleted event; flushing only the normal table would remove its
# drop-policy chains and could turn the boundary into accept-by-default.
cat > /etc/nftables.d/adad-killswitch-drop.nft <<'EOF'
flush ruleset

table inet adad_killswitch {
  chain input {
    type filter hook input priority 0; policy drop;
    iifname "lo" accept
    ct state established,related accept
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
  }

  chain output {
    type filter hook output priority 0; policy drop;
    oifname "lo" accept
  }
}
EOF

cat > /etc/tor/torrc.d/adad.conf <<'EOF'
SocksPort 127.0.0.1:9050
DNSPort 127.0.0.1:5353
AutomapHostsOnResolve 1
ClientUseIPv6 0
ClientPreferIPv6ORPort 0
EOF

cat > /etc/wireguard/README.adad <<'EOF'
ADAD loads WireGuard configuration from the unlocked vault at runtime.
No private key is baked into the live image.
EOF

cat > /usr/local/sbin/adad-killswitch-boot <<'EOF'
#!/bin/sh
set -eu

sysctl -w net.ipv6.conf.all.disable_ipv6=1 >/dev/null
sysctl -w net.ipv6.conf.default.disable_ipv6=1 >/dev/null
sysctl -w net.ipv6.conf.lo.disable_ipv6=1 >/dev/null

nft -f /etc/nftables.d/adad-killswitch.nft

random_local_mac() {
  first=$(od -An -N1 -tu1 /dev/urandom | tr -d ' ')
  first=$(( (first | 2) & 254 ))
  rest=$(od -An -N5 -tx1 /dev/urandom | tr -d ' \n')
  printf '%02x:%s:%s:%s:%s:%s\n' \
    "$first" \
    "$(printf '%s' "$rest" | cut -c1-2)" \
    "$(printf '%s' "$rest" | cut -c3-4)" \
    "$(printf '%s' "$rest" | cut -c5-6)" \
    "$(printf '%s' "$rest" | cut -c7-8)" \
    "$(printf '%s' "$rest" | cut -c9-10)"
}

for path in /sys/class/net/*; do
  iface=$(basename "$path")
  [ "$iface" = "lo" ] && continue
  mac=$(random_local_mac)
  ip link set dev "$iface" down 2>/dev/null || true
  ip link set dev "$iface" address "$mac" 2>/dev/null || true
  ip link set dev "$iface" up 2>/dev/null || true
done

printf '%s\n' 'adad-killswitch: armed' > /dev/console || true
printf '%s\n' 'adad-ipv6: disabled' > /dev/console || true
printf '%s\n' 'adad-mac: randomized' > /dev/console || true
EOF
chmod 0755 /usr/local/sbin/adad-killswitch-boot

cat > /usr/local/sbin/adad-llama-start <<'EOF'
#!/bin/sh
set -eu

[ -x /usr/local/bin/llama-server ] || {
  echo 'ADAD local model runtime is missing.' >&2
  exit 1
}
[ -r /var/lib/adad/models/default.gguf ] || {
  echo 'ADAD local model artifact is missing.' >&2
  exit 1
}
exec /usr/local/bin/llama-server \
  --model /var/lib/adad/models/default.gguf \
  --host 127.0.0.1 \
  --port 8080
EOF
chmod 0755 /usr/local/sbin/adad-llama-start

cat > /etc/systemd/system/adad-llama.service <<'EOF'
[Unit]
Description=ADAD local llama.cpp inference server
Requires=adad-killswitch.service
After=adad-killswitch.service network.target
ConditionPathExists=/usr/local/bin/llama-server
ConditionPathExists=/var/lib/adad/models/default.gguf

[Service]
Type=simple
User=nobody
Group=nogroup
ExecStart=/usr/local/sbin/adad-llama-start
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/adad-killswitch-monitor.service <<'EOF'
[Unit]
Description=ADAD dynamic fail-closed link monitor
Requires=adad-killswitch.service
After=adad-killswitch.service network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/leakguard monitor
Restart=always
RestartSec=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
EOF

cat > /usr/local/sbin/adad-leak-battery <<'EOF'
#!/bin/sh
set -eu

console_pass() {
  printf '%s\n' "adad-leak-battery: $1: pass" > /dev/console || true
}

console_fail() {
  printf '%s\n' "adad-leak-battery: $1: fail" > /dev/console || true
  systemctl poweroff --no-wall >/dev/null 2>&1 || poweroff -f || true
  exit 1
}

require_cmd() {
  command -v "$1" >/dev/null 2>&1 || console_fail "missing-$1"
}

require_cmd nft
require_cmd ip
require_cmd sysctl
require_cmd systemctl
require_cmd timeout
require_cmd cryptsetup
require_cmd losetup
require_cmd mkfs.ext4
require_cmd mount
require_cmd umount
require_cmd truncate
require_cmd git
require_cmd ssh
require_cmd ping
require_cmd tor
require_cmd wg
require_cmd wg-quick
require_cmd llama-server
[ -r /var/lib/adad/models/default.gguf ] || console_fail "llama-model"
systemctl is-enabled adad-llama.service >/dev/null 2>&1 || console_fail "llama-enabled"
systemctl is-active --quiet adad-llama.service || console_fail "llama-active"
console_pass "llama-runtime"

systemctl is-enabled adad-killswitch-monitor.service >/dev/null 2>&1 || console_fail "killswitch-monitor-enabled"
systemctl is-active --quiet adad-killswitch-monitor.service || console_fail "killswitch-monitor-active"
console_pass "killswitch-monitor"

for tool in agent-coding forge git-spoof leakguard metafuse persona vps-deploy xmr-wallet; do
  [ -x "/usr/local/bin/$tool" ] || console_fail "tool-$tool"
  help_output=$("/usr/local/bin/$tool" --help 2>/dev/null) || console_fail "help-$tool"
  printf '%s\n' "$help_output" | grep -q 'Usage:' || console_fail "help-$tool"
done
console_pass "static-tools"

/usr/local/bin/leakguard status >/dev/null 2>&1 || console_fail "dispatch-leakguard"
/usr/local/bin/leakguard wireguard status >/dev/null 2>&1 || console_fail "dispatch-wireguard"
/usr/local/bin/metafuse scrub /etc/hostname >/dev/null 2>&1 || console_fail "dispatch-metafuse"
/usr/local/bin/git-spoof rewrite-metadata 'ADAD image smoke' >/dev/null 2>&1 || console_fail "dispatch-git-spoof"
git_smoke_dir=$(mktemp -d)
trap 'rm -rf "$git_smoke_dir"' EXIT HUP INT TERM
git -C "$git_smoke_dir" init -q || console_fail "git-spoof-init"
git -C "$git_smoke_dir" config commit.gpgsign false || console_fail "git-spoof-config"
printf '%s\n' 'ADAD image smoke' > "$git_smoke_dir/tracked.txt"
git -C "$git_smoke_dir" add -- tracked.txt || console_fail "git-spoof-add"
(
  cd "$git_smoke_dir"
  ADAD_PSEUDONYM=image-smoke \
  ADAD_GIT_AUTHOR_NAME='Image Smoke' \
  ADAD_GIT_AUTHOR_EMAIL=image-smoke@example.invalid \
    /usr/local/bin/git-spoof commit 'ADAD image smoke' >/dev/null 2>&1
) || console_fail "git-spoof-commit"
git -C "$git_smoke_dir" show -s --format='%an%n%ae%n%aI%n%cn%n%ce%n%cI' |
  grep -Fx 'Image Smoke' >/dev/null || console_fail "git-spoof-identity"
git -C "$git_smoke_dir" show -s --format='%an%n%ae%n%aI%n%cn%n%ce%n%cI' |
  grep -Fx 'image-smoke@example.invalid' >/dev/null || console_fail "git-spoof-email"
git -C "$git_smoke_dir" show -s --format='%aI%n%cI' |
  grep -Fx '2000-01-01T00:00:00Z' >/dev/null || console_fail "git-spoof-timestamp"
console_pass "git-spoof-commit"
dms_smoke_image="$git_smoke_dir/dms.img"
printf 'LUKS\272\276\000\002' > "$dms_smoke_image"
truncate -s 256 "$dms_smoke_image"
dms_output=$(/usr/local/bin/leakguard dms evaluate-image "$dms_smoke_image" 128 1000 1061 60) || console_fail "dms-image-evaluate"
printf '%s\n' "$dms_output" | grep -Fx 'dms=Expired header_wiped=true image_only=true' >/dev/null || console_fail "dms-image-wipe"
console_pass "dms-image"
if ! timeout 30 /usr/local/bin/agent-coding chat 'Write exactly the word ok.' \
  >/tmp/adad-agent-chat.out 2>/tmp/adad-agent-chat.err; then
  console_fail "agent-chat"
fi
[ -s /tmp/adad-agent-chat.out ] || console_fail "agent-chat-empty"
console_pass "agent-chat"

[ "$(sysctl -n net.ipv6.conf.all.disable_ipv6)" = "1" ] || console_fail "ipv6-all"
[ "$(sysctl -n net.ipv6.conf.default.disable_ipv6)" = "1" ] || console_fail "ipv6-default"
[ "$(sysctl -n net.ipv6.conf.lo.disable_ipv6)" = "1" ] || console_fail "ipv6-lo"
console_pass "ipv6"

rules=$(nft list ruleset)
printf '%s\n' "$rules" | grep -q 'table inet adad_killswitch' || console_fail "nft-table"
printf '%s\n' "$rules" | grep -q 'policy drop' || console_fail "nft-policy"
printf '%s\n' "$rules" | grep -q 'oifname "wg0" accept' || console_fail "wireguard-allow"
grep -q 'meta skuid "debian-tor" accept' /etc/nftables.d/adad-killswitch.nft || console_fail "tor-allow"
grep -q 'udp dport { 53, 5353, 1900, 137, 138 } drop' /etc/nftables.d/adad-killswitch.nft || console_fail "udp-leak-blocks"
grep -q 'tcp dport { 139, 445 } drop' /etc/nftables.d/adad-killswitch.nft || console_fail "tcp-discovery-blocks"
console_pass "killswitch"
console_pass "dns-discovery"

grep -q '^ClientUseIPv6 0$' /etc/tor/torrc.d/adad.conf || console_fail "tor-ipv6"
grep -q '^DNSPort 127.0.0.1:5353$' /etc/tor/torrc.d/adad.conf || console_fail "tor-dns"
systemctl is-enabled tor.service >/dev/null 2>&1 || console_fail "tor-enabled"
console_pass "tor-default"

for path in /sys/class/net/*; do
  iface=$(basename "$path")
  [ "$iface" = "lo" ] && continue
  mac=$(cat "$path/address")
  first_hex=${mac%%:*}
  first=$((0x$first_hex))
  [ $((first & 1)) -eq 0 ] || console_fail "mac-multicast-$iface"
  [ $((first & 2)) -eq 2 ] || console_fail "mac-local-$iface"
done
console_pass "mac"

if timeout 5 ping -4 -c 1 -W 1 1.1.1.1 >/tmp/adad-clearnet-ping.log 2>&1; then
  console_fail "clearnet"
fi
console_pass "clearnet"

drop_iface=""
for path in /sys/class/net/*; do
  iface=$(basename "$path")
  [ "$iface" = "lo" ] && continue
  drop_iface=$iface
  break
done

[ -n "$drop_iface" ] || console_fail "drop-interface"
ip link set dev "$drop_iface" down 2>/dev/null || console_fail "drop-interface-down"
sleep 1
rules_after=$(nft list ruleset)
printf '%s\n' "$rules_after" | grep -q 'table inet adad_killswitch' || console_fail "drop-nft-table"
printf '%s\n' "$rules_after" | grep -q 'policy drop' || console_fail "drop-nft-policy"
printf '%s\n' "$rules_after" | grep -q 'oifname "lo" accept' || console_fail "drop-loopback"
if printf '%s\n' "$rules_after" | grep -q 'oifname "wg0" accept'; then
  console_fail "drop-wireguard-allow"
fi
if timeout 5 ping -4 -c 1 -W 1 1.1.1.1 >/tmp/adad-drop-ping.log 2>&1; then
  console_fail "drop-clearnet"
fi
ip link set dev "$drop_iface" up 2>/dev/null || console_fail "drop-interface-restore"
console_pass "drop"

printf '%s\n' 'adad-leak-battery: all: pass' > /dev/console || true
systemctl poweroff --no-wall >/dev/null 2>&1 || poweroff -f || true
EOF
chmod 0755 /usr/local/sbin/adad-leak-battery

cat > /etc/systemd/system/adad-killswitch.service <<'EOF'
[Unit]
Description=ADAD fail-closed network posture
DefaultDependencies=no
After=local-fs.target systemd-sysctl.service
Before=network-pre.target network.target tor.service
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/adad-killswitch-boot
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/adad-leak-battery.service <<'EOF'
[Unit]
Description=ADAD on-image leak battery
ConditionKernelCommandLine=adad.leak_battery=1
Requires=adad-killswitch.service
Requires=adad-llama.service
After=adad-killswitch.service adad-llama.service tor.service network.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/adad-leak-battery
TimeoutStartSec=90
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
EOF

systemctl enable adad-killswitch.service
systemctl enable adad-killswitch-monitor.service
systemctl enable adad-leak-battery.service
systemctl enable adad-llama.service
systemctl enable tor.service
